                            start-indent="inherit"
                            line-height="11pt"
                            id="d61e795">&lt;extensions&gt;
   &lt;extension&gt;
      &lt;name&gt;org.osgi.service.event&lt;/name&gt;
      &lt;path&gt;contributions/eventadmin&lt;/path&gt;
