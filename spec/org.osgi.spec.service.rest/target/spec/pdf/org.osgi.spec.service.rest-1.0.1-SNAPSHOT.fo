                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>137.10</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>org.osgi.service.rest<fo:inline id="org.osgi.service.rest-version"/>
                                       </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
