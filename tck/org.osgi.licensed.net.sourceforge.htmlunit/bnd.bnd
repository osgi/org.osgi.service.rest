# Third-party bundle without its own source code: the original ships it as
# a ready-made jar (licensed/repo) that moved into this module via
# keepPaths/moves. bnd repackages it here unchanged (-includeresource: @jar)
# into a bundle artifact with an explicit BSN/version, instead of placing
# the jar into the local repository by hand.
-includeresource: @net.sourceforge.htmlunit-2.15.0.jar
-fixupmessages: "Split package*"
